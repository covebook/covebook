<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 시스템 시작 화면: 흰 바탕 + 앱 시작 그림의 책(2026-11-16 QA 영숙 F17: 빈 로고라 흰 화면만 2~3초 보였다) -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_book_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splashscreen_background</item>
        <!-- 지금 앱(AppTheme)처럼 상태·내비 막대 투명, 세 단추 내비의 짙은 대비 막 끄기 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
</resources>
