default_platform(:ios)
platform :ios do
  desc "Sign Flutter build and upload only to TestFlight"
  lane :beta do
    root = File.expand_path("..", __dir__)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY").gsub('\\n', "\n"), in_house: false
    )
    update_code_signing_settings(
      use_automatic_signing: false, path: File.join(root, "ios/Runner.xcodeproj"),
      team_id: ENV.fetch("APPLE_TEAM_ID"), targets: ["Runner"], build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution", profile_name: ENV.fetch("IOS_PROFILE_NAME")
    )
    Dir.chdir(root) do
      sh("flutter", "build", "ipa", "--release", "--build-number=#{ENV.fetch('IOS_BUILD_NUMBER')}",
       "--dart-define=SYNC_URL=https://covebook.kodeploy.com",
       "--export-options-plist=#{ENV.fetch('RUNNER_TEMP')}/ExportOptions.plist")
    end
    upload_to_testflight(
      api_key: api_key, app_identifier: "app.covebook", ipa: Dir[File.join(root, "build/ios/ipa/*.ipa")].fetch(0),
      distribute_external: false, skip_submission: true,
      skip_waiting_for_build_processing: false
    )
  end
end
